generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Multi-tenant Architecture: Company represents a Tenant
model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique // CNPJ or CPF
  licenseStatus String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL, EXPIRED, READ_ONLY
  licenseExpiresAt DateTime @default(now())

  // ── MULTISSETORIAL: Perfil da Empresa ──────────────────────────────────────
  // Versão contratada do RP (ex: RP Supermercado, RP Padaria, RP Restaurante, RP Distribuidora, RP Fábrica, RP Enterprise)
  segment         String? @default("SUPERMARKET")
  // JSON string: ["RETAIL","DISTRIBUTOR","FACTORY","WHOLESALE","FOOD","PRODUCTION"]
  operationTypes  String  @default("[\"RETAIL\"]")
  // JSON string: lista de keys de módulos ativos ex: ["PDV","STOCK","DISTRIBUTION"]
  activeModules   String  @default("[]")

  // ── CUSTO OPERACIONAL & PRECIFICAÇÃO ──────────────────────────────────────
  defaultOperationalRate  Float?   @default(15.0)  // Taxa de custo operacional padrão (%)
  defaultProfitMargin     Float?   @default(25.0)  // Margem de lucro desejada padrão (%)
  defaultFreightOther     Float?   @default(0.0)   // Frete / outras despesas padrão (%)
  operationalCostDetails  String?  @default("{}")  // JSON: composição detalhada (folha, aluguel, energia, perdas, taxas, etc.)

  // Hierarquia multi-empresa (fábrica -> distribuidora -> loja)
  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies  Company[] @relation("CompanyHierarchy")

  planId        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  products      Product[]
  categories    Category[]
  customers     Customer[]
  sales         Sale[]
  cashRegisters CashRegister[]
  transactions  Transaction[]
  subscriptions Subscription[]
  stockEntries  StockEntry[]
  sellers       Seller[]
  orders        Order[]
  invoices       Invoice[]
  fiscalConfig   FiscalConfig?
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  recipes        Recipe[]
  productionLogs ProductionLog[]
  campaigns      Campaign[]
  luckyCoupons   LuckyCoupon[]
  deviceSyncs    DeviceSync[]
  taxGrids       TaxGrid[]
  theme          TenantTheme?
  returns        Return[]
  losses         Loss[]
  stores         Store[]
  pdvTerminals   PdvTerminal[]
  roles          Role[]
  approvalRules  ApprovalRule[]
  approvalRequests ApprovalRequest[]
  auditLogs      AuditLog[]

  // Novos módulos multissetoriais
  companyModules    CompanyModule[]
  warehouses        Warehouse[]
  priceTables       PriceTable[]
  deliveryRoutes    DeliveryRoute[]
  vehicles          Vehicle[]
  drivers           Driver[]
  productionOrders  ProductionOrder[]

  plan           Plan?    @relation(fields: [planId], references: [id])

  @@map("companies")
}

// ─────────────────────────────────────────────
// SAAS SYSTEM ADMIN
// ─────────────────────────────────────────────

model SystemUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("SUPER_ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_users")
}

model Plan {
  id               String   @id @default(uuid())
  name             String   // Starter, Pro, Premium, Enterprise
  description      String?
  price            Decimal
  maxUsers         Int      @default(0) // 0 = unlimited
  maxProducts      Int      @default(0)
  maxCustomers     Int      @default(0)
  maxInvoices      Int      @default(0)
  features         String?  // JSON string format
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companies        Company[]

  @@map("plans")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  pin       String?  // PIN de 4 a 6 dígitos para liberação rápida no PDV
  role      String   @default("OPERATOR") // ADMIN, MANAGER, SUPERVISOR, OPERATOR, VIEWER
  roleId    String?  // ID do Role customizado ou padrão
  active    Boolean  @default(true)
  lastLogin DateTime?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleRelation        Role?             @relation(fields: [roleId], references: [id])
  userStores          UserStore[]
  userPermissions     UserPermission[]
  requestedApprovals  ApprovalRequest[] @relation("RequestedApprovals")
  authorizedApprovals ApprovalRequest[] @relation("AuthorizedApprovals")
  auditLogs           AuditLog[]        @relation("UserAuditLogs")
  authorizedAuditLogs AuditLog[]        @relation("AuthorizerAuditLogs")

  sales         Sale[]
  cashRegisters CashRegister[] @relation("CashierOperator")
  cashMovements CashMovement[] @relation("MovementUser")
  stockEntries  StockEntry[]
  purchaseOrders PurchaseOrder[]
  seller        Seller?
  productionLogs ProductionLog[]
  returns        Return[]
  losses         Loss[]
  productionOrders ProductionOrder[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("categories")
}

model Product {
  id      String   @id @default(uuid())
  name    String
  barcode String?
  price   Decimal
  cost    Decimal?
  stock   Float    @default(0)
  unit    String   @default("UN") // UN, KG, LT

  // Fiscal Info (Antigos e Novos Reforma)
  ncm             String?
  cest            String?

  // Saída (Emissão NF-e de Venda)
  cfop            String?
  cst             String?
  csosn           String?
  origin          String?  @default("0") // Origem da Mercadoria (0, 1, 2, etc.)
  icmsRate        Decimal? @default(0)   // Alíquota ICMS Saída (%)
  icmsRedBaseRate Decimal? @default(0)   // Redução BC ICMS Saída (%)
  cstPis          String?                // CST PIS Saída
  pisRate         Decimal? @default(0)   // Alíquota PIS Saída (%)
  cstCofins       String?                // CST COFINS Saída
  cofinsRate      Decimal? @default(0)   // Alíquota COFINS Saída (%)
  cstIpi          String?                // CST IPI Saída
  ipiRate         Decimal? @default(0)   // Alíquota IPI Saída (%)
  fecoepRate      Decimal? @default(0)   // Alíquota FECOEP / FCP Saída (%)

  // Entrada (Recebimento / Compra)
  cfopIn          String?                // CFOP Entrada (ex: 1102, 2102)
  cstIn           String?                // CST/CSOSN Entrada
  icmsRateIn      Decimal? @default(0)   // Alíquota ICMS Entrada (%)
  icmsRedBaseRateIn Decimal? @default(0) // Redução BC ICMS Entrada (%)
  fecoepRateIn    Decimal? @default(0)   // Alíquota FECOEP / FCP Entrada (%)
  cstPisIn        String?                // CST PIS Entrada
  pisRateIn       Decimal? @default(0)   // Alíquota PIS Entrada (%)
  cstCofinsIn     String?                // CST COFINS Entrada
  cofinsRateIn    Decimal? @default(0)   // Alíquota COFINS Entrada (%)
  cstIpiIn        String?                // CST IPI Entrada
  ipiRateIn       Decimal? @default(0)   // Alíquota IPI Entrada (%)

  // Balança e Produção Própria
  isSelfProduced Boolean @default(false)
  internalCode   String? // 5 dígitos para Prix Toledo

  // Familiarização / Variações
  parentProductId String?
  parentProduct   Product?  @relation("ProductFamily", fields: [parentProductId], references: [id])
  variations      Product[] @relation("ProductFamily")

  // Reforma Tributária
  ibsRate Decimal? @default(0) // Imposto sobre Bens e Serviços
  cbsRate Decimal? @default(0) // Contribuição sobre Bens e Serviços
  isRate  Decimal? @default(0) // Imposto Seletivo

  // ── MULTISSETORIAL: Produto Universal ────────────────────────────────────
  sku             String?  // SKU único do produto
  brand           String?  // Marca
  manufacturer    String?  // Fabricante

  // Unidades múltiplas (Distribuição / Indústria / Metais)
  unitPurchase    String?  // Unidade de compra (CX, FD, KG, TON, BARRA, BOBINA)
  unitSale        String?  // Unidade de venda (UN, KG, MT, TON)
  unitConvFactor  Float?   @default(1)   // Fator de conversão: 1 caixa = N unidades

  // Embalagem comercial
  packagingType   String?  // UNIT | BOX | PALLET | BAG | BUNDLE | BARRA | BOBINA | CHAPA
  unitsPerPack    Float?   @default(1)   // Ex: 1 caixa = 12 unidades
  minOrderQty     Float?   @default(1)   // Quantidade mínima de pedido (MOQ)

  // Dimensões e peso (logística / frete)
  grossWeight     Decimal? // Peso bruto (kg)
  netWeight       Decimal? // Peso líquido (kg)
  width           Decimal? // Largura (cm)
  height          Decimal? // Altura (cm)
  depth           Decimal? // Profundidade / Comprimento (cm)

  // Tipo do produto (flags)
  isRawMaterial   Boolean  @default(false) // Matéria-prima
  isFinishedGood  Boolean  @default(false) // Produto acabado
  isPackaging     Boolean  @default(false) // Embalagem

  // Controle de estoque avançado
  minStock        Float?   @default(0)   // Estoque mínimo
  maxStock        Float?               // Estoque máximo
  leadTimeDays    Int?     @default(0)   // Prazo de reposição (dias)
  // ─────────────────────────────────────────────────────────────────────────

  categoryId String?
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Label/Price tracking
  priceChangedAt  DateTime?  // Última alteração de preço
  labelPrintedAt  DateTime?  // Última impressão de etiqueta

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id])
  saleItems       SaleItem[]
  batches         ProductBatch[]
  stockEntryItems StockEntryItem[]
  orderItems      OrderItem[]
  purchaseItems   PurchaseOrderItem[]
  recipe          Recipe?
  recipeItems     RecipeItem[]
  returnItems     ReturnItem[]
  losses          Loss[]
  campaigns       Campaign[]
  warehouseStocks WarehouseStock[]
  transferItems   StockTransferItem[]
  priceTableItems PriceTableItem[]
  pickingItems    PickingListItem[]
  productionConsumptions ProductionConsumption[]

  @@unique([barcode, companyId])
  @@unique([internalCode, companyId])
  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  companyId String
  sellerId  String?  // Vendedor responsável pelo cliente
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Fidelidade e CRM (B2C)
  cashbackBalance Decimal  @default(0)
  pointsBalance   Int      @default(0)

  // ── MULTISSETORIAL: Cliente B2B ──────────────────────────────────────────
  personType      String?  @default("PF") // PF | PJ
  ie              String?  // Inscrição Estadual
  taxRegime       String?  // Simples Nacional, Lucro Presumido, etc.
  creditLimit     Decimal? @default(0)    // Limite de crédito
  creditUsed      Decimal? @default(0)    // Crédito utilizado
  priceTableId    String?  // Tabela de preço vinculada
  region          String?  // Região de atendimento
  notes           String?  // Observações gerais
  // ─────────────────────────────────────────────────────────────────────────

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seller        Seller?        @relation(fields: [sellerId], references: [id])
  sales         Sale[]
  subscriptions Subscription[]
  orders        Order[]
  cashbackLogs  CashbackLog[]
  pointsLogs    PointsLog[]
  luckyCoupons  LuckyCoupon[]
  returns       Return[]
  deliveryAddresses DeliveryAddress[]

  @@map("customers")
}

model Sale {
  id       String  @id @default(uuid())
  subtotal Decimal
  discount Decimal @default(0)
  total    Decimal
  status   String  @default("COMPLETED")

  userId         String
  customerId     String?
  cashRegisterId String?
  companyId      String
  sellerId       String?  // Vendedor da venda
  orderId        String?  // Pedido de televendas origem
  invoiceId      String?  // NF-e emitida
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seller       Seller?       @relation(fields: [sellerId], references: [id])

  items    SaleItem[]
  payments SalePayment[]
  returns  Return[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Float
  unitPrice Decimal
  total     Decimal

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id            String  @id @default(uuid())
  saleId        String
  amount        Decimal
  paymentMethod String

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

model CashRegister {
  id            String    @id @default(uuid())
  openingTime   DateTime  @default(now())
  closingTime   DateTime?
  initialValue  Decimal
  finalValue    Decimal?
  expectedValue Decimal?
  status        String    @default("OPEN")

  operatorId String
  companyId  String

  operator  User           @relation("CashierOperator", fields: [operatorId], references: [id])
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements CashMovement[]
  sales     Sale[]

  @@map("cash_registers")
}

model CashMovement {
  id          String   @id @default(uuid())
  type        String
  amount      Decimal
  description String?
  timestamp   DateTime @default(now())

  cashRegisterId String
  userId         String

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  user         User         @relation("MovementUser", fields: [userId], references: [id])

  @@map("cash_movements")
}

model Transaction {
  id            String    @id @default(uuid())
  type          String
  description   String
  category      String?
  amount        Decimal
  paymentMethod String?
  dueDate       DateTime
  paymentDate   DateTime?
  status        String    @default("PENDING")
  provider      String?
  attachmentUrl String?

  // ── MULTISSETORIAL: Financeiro Avançado ──────────────────────────────────
  orderId           String?  // Vínculo com pedido de venda B2B
  sellerId          String?  // Comissão de vendedor
  costCenter        String?  // Centro de custo
  installment       Int?     @default(1)  // Número da parcela
  totalInstallments Int?     @default(1)  // Total de parcelas
  // ─────────────────────────────────────────────────────────────────────────

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Subscription {
  id       String  @id @default(uuid())
  planName String
  amount   Decimal
  dueDate  Int // Day of the month
  status   String  @default("ACTIVE")

  customerId String
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model StockEntry {
  id          String   @id @default(uuid())
  invoiceNum  String?  // Número da NF
  totalAmount Decimal
  entryDate   DateTime @default(now())

  companyId   String
  userId      String
  supplierId  String?
  purchaseOrderId String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  items         StockEntryItem[]

  @@map("stock_entries")
}

model StockEntryItem {
  id             String   @id @default(uuid())
  quantity       Float
  unitCost       Decimal
  expirationDate DateTime?
  batchNumber    String?

  stockEntryId   String
  productId      String

  stockEntry     StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])

  @@map("stock_entry_items")
}

model ProductBatch {
  id             String   @id @default(uuid())
  batchNumber    String?
  expirationDate DateTime
  initialStock   Float
  currentStock   Float
  
  productId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_batches")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  tradeName String?  // Nome Fantasia
  document  String?  // CNPJ / CPF
  stateReg  String?  // Inscrição Estadual (IE)
  municipalReg String? // Inscrição Municipal (IM)
  taxRegime String?  // Simples Nacional, Lucro Presumido, Lucro Real, MEI
  isIcmsContributor Boolean @default(false)
  suframa   String?  // Código Suframa
  
  // Condições Comerciais Padrão
  defaultPaymentTerm String? // ex: 30 dias
  discountPercent    Decimal @default(0)

  // Contato Geral
  email     String?
  phone     String?
  phone2    String?
  quoteEmail String? // E-mail específico para cotações

  // Pessoa de Contato
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Endereço
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String? @default("Brasil")

  // Logística / Entregas
  deliveryDays      String? // Dias de entrega (JSON ou string de dias, ex: "Seg,Quar")
  deliveryLeadDays  Int?    @default(0) // Dias de prazo de entrega
  minOrderValue     Decimal @default(0)
  deliveryNotes     String?

  // Categoria, Segmento, Avaliação e Status
  category    String? @default("Outros")
  segment     String? @default("Geral") // Padaria, Restaurante, Supermercado, Distribuidora, Fábrica
  systemType  String? @default("Outros") // Versão do RP utilizado
  rating      Int     @default(5)
  status    String  @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  notes     String? // Observações Gerais

  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockEntries   StockEntry[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────
// COMPRAS E RECEBIMENTO
// ─────────────────────────────────────────────

model PurchaseOrder {
  id          String   @id @default(uuid())
  orderNumber String?
  status      String   @default("DRAFT") // DRAFT, APPROVED, SENT, RECEIVED, PARTIAL, CANCELED
  totalAmount Decimal
  companyId   String
  supplierId  String
  userId      String   // Usuário que criou/aprovou
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
  stockEntries StockEntry[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  quantity        Float
  receivedQty     Float    @default(0)
  unitCost        Decimal
  total           Decimal
  
  purchaseOrderId String
  productId       String

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────
// TELEVENDAS & FISCAL
// ─────────────────────────────────────────────

model Seller {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  email        String?
  commission   Float    @default(0)  // % de comissão padrão
  goal         Decimal? // Meta mensal
  active       Boolean  @default(true)
  companyId    String
  userId       String   @unique       // Vinculado a um User
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── MULTISSETORIAL: Vendedor B2B ─────────────────────────────────────────
  cpf            String?  // CPF do vendedor
  region         String?  // Região de atuação
  commissionType String?  @default("SALE") // SALE | INVOICE | COLLECTION
  // ─────────────────────────────────────────────────────────────────────────

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
  customers Customer[]
  orders    Order[]
  sales     Sale[]

  @@map("sellers")
}

model Order {
  id         String   @id @default(uuid())
  // Status expandido para distribuição
  // DRAFT | CONFIRMED | PICKING | PICKED | INVOICED | IN_TRANSIT | DELIVERED | CANCELED
  status     String   @default("DRAFT")
  subtotal   Decimal
  discount   Decimal  @default(0)
  total      Decimal
  notes      String?

  customerId String?
  sellerId   String?
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ── MULTISSETORIAL: Pedido B2B ───────────────────────────────────────────
  orderNumber       String?  // Número do pedido do cliente
  paymentTerm       String?  // "30/60/90 dias", "À vista", "7 dias"
  freightType       String?  @default("CIF") // CIF | FOB
  carrierId         String?  // ID da transportadora (Supplier)
  deliveryAddressId String?  // Endereço de entrega do cliente
  priceTableId      String?  // Tabela de preço aplicada
  expectedDelivery  DateTime? // Data prevista de entrega
  // ─────────────────────────────────────────────────────────────────────────

  customer  Customer?   @relation(fields: [customerId], references: [id])
  seller    Seller?     @relation(fields: [sellerId], references: [id])
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  invoices  Invoice[]
  routeStops RouteStop[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Decimal
  discount  Decimal @default(0)
  total     Decimal
  cost      Decimal @default(0) // Custo unitário para cálculo de margem

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Invoice {
  id          String   @id @default(uuid())
  type        String   // NFe | NFCe | Cupom
  number      String?
  series      String   @default("1")
  accessKey   String?  // Chave 44 dígitos
  status      String   @default("PENDING") // PENDING | AUTHORIZED | CANCELED | REJECTED
  environment String   @default("homologacao") // homologacao | producao
  xmlUrl      String?
  pdfUrl      String?
  errorMsg    String?

  orderId   String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order?  @relation(fields: [orderId], references: [id])
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  returns Return[]

  @@map("invoices")
}

model FiscalConfig {
  id                String   @id @default(uuid())
  cnpj              String
  ie                String?  // Inscrição Estadual
  im                String?  // Inscrição Municipal
  companyName       String
  tradeName         String?
  taxRegime         String   @default("SN") // SN | LP | LR (Simples Nacional, Lucro Presumido, Lucro Real)
  environment       String   @default("homologacao") // homologacao | producao
  nfeSeries         String   @default("1")
  nfceeSeries       String   @default("1")
  nextNfeNumber     Int      @default(1)
  nextNfceNumber    Int      @default(1)
  
  // Endereço
  street            String?
  number            String?
  district          String?
  city              String?
  state             String?
  zipCode           String?
  
  // Emissor NF-e (Focus NFe)
  focusNfeToken     String?  // Token da API Focus NFe
  emitterEndpoint   String?  // Endpoint personalizado
  
  // Certificado Digital A1
  certPath          String?  // Caminho do arquivo .pfx no servidor
  certPassword      String?  // Senha criptografada
  certExpiration    DateTime? // Data de expiração do certificado
  certUploaded      Boolean  @default(false)

  companyId String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("fiscal_configs")
}

// Ficha Técnica (Receita)
model Recipe {
  id          String       @id @default(uuid())
  productId   String       @unique // Produto acabado produzido (ex: Pão Francês)
  yield       Float        @default(1) // Rendimento da receita (ex: 50 unidades ou 1kg)
  instructions String?     // Modo de preparo
  companyId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       RecipeItem[]
  productions ProductionLog[]
  productionOrders ProductionOrder[]

  @@map("recipes")
}

// Item da Ficha Técnica (Insumo)
model RecipeItem {
  id         String   @id @default(uuid())
  recipeId   String
  productId  String   // Insumo utilizado (ex: Farinha de Trigo)
  quantity   Float    // Quantidade necessária para o rendimento
  unit       String   @default("KG") // Unidade do insumo (KG, G, L, UN)

  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("recipe_items")
}

// Histórico/Log de Produção
model ProductionLog {
  id               String   @id @default(uuid())
  recipeId         String
  quantityProduced Float
  batchNumber      String?  // Lote gerado
  expirationDate   DateTime? // Validade calculada
  userId           String
  companyId        String
  createdAt        DateTime @default(now())

  recipe           Recipe   @relation(fields: [recipeId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("production_logs")
}

// ─────────────────────────────────────────────
// CRM E MARKETING
// ─────────────────────────────────────────────

model Campaign {
  id             String   @id @default(uuid())
  name           String
  type           String   // DISCOUNT, CASHBACK, BOGO (Buy one get one), POINTS, RAFFLE
  description    String?
  startDate      DateTime
  endDate        DateTime?
  active         Boolean  @default(true)
  rules          String?  // JSON with specific rules
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  luckyCoupons   LuckyCoupon[]

  @@map("campaigns")
}

model LuckyCoupon {
  id             String   @id @default(uuid())
  code           String   // Unique generated code
  qrCodeUrl      String?
  used           Boolean  @default(false)
  issuedAt       DateTime @default(now())
  
  campaignId     String
  customerId     String?
  companyId      String

  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer       Customer? @relation(fields: [customerId], references: [id])
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("lucky_coupons")
}

model CashbackLog {
  id             String   @id @default(uuid())
  amount         Decimal
  type           String   // EARN, REDEEM, EXPIRE
  description    String?
  createdAt      DateTime @default(now())

  customerId     String
  saleId         String?  // If tied to a specific sale

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("cashback_logs")
}

model PointsLog {
  id             String   @id @default(uuid())
  points         Int
  type           String   // EARN, REDEEM, EXPIRE
  description    String?
  createdAt      DateTime @default(now())

  customerId     String
  saleId         String?  // If tied to a specific sale

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("points_logs")
}

// ─────────────────────────────────────────────
// CYBERSYNC SERVICE
// ─────────────────────────────────────────────

model DeviceSync {
  id             String   @id @default(uuid())
  deviceName     String
  deviceIp       String?
  lastSync       DateTime @default(now())
  status         String   @default("ONLINE") // ONLINE, OFFLINE, SYNCING
  version        String?  // Software version of PDV
  
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("device_syncs")
}

// ─────────────────────────────────────────────
// TERMINAIS E CAIXAS PDV (PAREAMENTO DESKTOP)
// ─────────────────────────────────────────────

model PdvTerminal {
  id             String    @id @default(uuid())
  code           String    @unique // Código de pareamento ex: "PDV-7842"
  name           String    @default("Caixa PDV") // ex: "Caixa 01 - Frente de Loja"
  cashierNumber  Int       @default(1) // Número do caixa (1, 2, 3...)
  ipAddress      String?
  macAddress     String?
  version        String?   @default("2.0.0")
  status         String    @default("PENDING") // PENDING, ACTIVE, BLOCKED, INACTIVE
  pairedAt       DateTime?
  lastHeartbeat  DateTime?
  token          String?   // Token gerado para comunicação segura

  companyId      String?
  storeId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store          Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([companyId])
  @@index([storeId])
  @@map("pdv_terminals")
}

// ─────────────────────────────────────────────
// FISCAL E GRADE TRIBUTÁRIA
// ─────────────────────────────────────────────

model TaxGrid {
  id             String   @id @default(uuid())
  name           String   // Ex: "Regime Normal - Varejo", "Simples Nacional"
  description    String?
  active         Boolean  @default(true)
  
  companyId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rules          TaxGridRule[]

  @@map("tax_grids")
}

model TaxGridRule {
  id             String   @id @default(uuid())
  taxGridId      String
  
  // Condições (Match)
  ncmPattern     String   @default("*") // Ex: "2204.*" ou exato
  cfopOrigin     String?  // Ex: "5102"
  cfopDest       String?  // Ex: "6102"
  stateOrigin    String?  // Ex: "SP"
  stateDest      String?  // Ex: "RJ"
  
  // Resultados (Alíquotas e Códigos)
  cstIcms        String?  // Ex: "00", "40", "60"
  csosn          String?  // Ex: "102", "500"
  icmsRate       Decimal  @default(0)
  pisRate        Decimal  @default(0)
  cofinsRate     Decimal  @default(0)
  
  // Reforma Tributária
  ibsRate        Decimal  @default(0)
  cbsRate        Decimal  @default(0)
  isRate         Decimal  @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taxGrid        TaxGrid  @relation(fields: [taxGridId], references: [id], onDelete: Cascade)

  @@map("tax_grid_rules")
}

// ─────────────────────────────────────────────
// WHITE LABEL E TEMAS
// ─────────────────────────────────────────────

model TenantTheme {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  logoPrincipal      String?
  logoPdv            String?
  logoImpressao      String?
  favicon            String?
  backgroundLogin    String?
  backgroundSistema  String?
  corPrimaria        String?
  corSecundaria      String?
  corMenu            String?
  corBotao           String?
  tema               String   @default("auto") // light, dark, auto
  customDomain       String?  @unique // Ex: erp.minhaempresa.com.br
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("tenant_themes")
}

// ─────────────────────────────────────────────
// TROCAS, DEVOLUÇÕES E PERDAS
// ─────────────────────────────────────────────

model Return {
  id            String   @id @default(uuid())
  saleId        String?  // Reference to original sale
  invoiceId     String?  // Reference to original invoice
  customerId    String   // Cliente obrigatório
  companyId     String
  userId        String
  status        String   @default("COMPLETED")
  totalAmount   Decimal
  creditApplied Boolean  @default(false)
  reason        String?
  createdAt     DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  sale        Sale?    @relation(fields: [saleId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  items       ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(uuid())
  returnId    String
  productId   String
  quantity    Float
  unitPrice   Decimal
  total       Decimal
  destiny     String   @default("STOCK") // STOCK, LOSS

  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  loss        Loss?

  @@map("return_items")
}

model Loss {
  id          String   @id @default(uuid())
  productId   String
  quantity    Float
  reason      String?
  companyId   String
  userId      String
  createdAt   DateTime @default(now())
  
  returnItemId String? @unique

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  returnItem  ReturnItem? @relation(fields: [returnItemId], references: [id])

  @@map("losses")
}

// ─────────────────────────────────────────────
// MULTI-STORE (MULTILOJA)
// ─────────────────────────────────────────────

model Store {
  id          String   @id @default(uuid())
  code        String   // Ex: LJ01, MATRIZ, FILIAL-ZS
  name        String   // Ex: Loja 1 - Matriz Centro
  tradeName   String?
  document    String?  // CNPJ da filial ou CPF
  ie          String?  // Inscrição Estadual
  phone       String?
  email       String?
  street      String?
  number      String?
  district    String?
  city        String?
  state       String?
  zipCode     String?
  active      Boolean  @default(true)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userStores       UserStore[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
  pdvTerminals     PdvTerminal[]

  @@unique([companyId, code])
  @@map("stores")
}

model UserStore {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("user_stores")
}

// ─────────────────────────────────────────────
// PERMISSIONS & ROLES (PERFIS E PERMISSÕES)
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  key         String   // ADMIN, MANAGER, SUPERVISOR, OPERATOR, VIEWER, ou custom
  name        String   // Administrador, Gerente, Supervisor, etc.
  description String?
  isSystem    Boolean  @default(false)
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // ex: pdv.cancel_sale, stock.inventory
  name        String   // Cancelar venda, Inventário, etc.
  module      String   // PDV, ESTOQUE, COMPRAS, FINANCEIRO, RELATORIOS, CONFIGURACOES
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  storeId      String?  // Se nulo, aplica para todas as lojas do usuário
  granted      Boolean  @default(true) // true = Concessão explícita, false = Revogação explícita
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, storeId])
  @@map("user_permissions")
}

// ─────────────────────────────────────────────
// REGRAS E CENTRAL DE LIBERAÇÕES (APPROVALS)
// ─────────────────────────────────────────────

model ApprovalRule {
  id          String   @id @default(uuid())
  companyId   String
  operation   String   // pdv.cancel_sale, pdv.cancel_item, pdv.apply_discount, pdv.change_price, pdv.bleed, pdv.refund_sale, stock.loss, stock.adjust, finance.cancel_entry
  name        String   // Cancelamento de Venda, Desconto no PDV, etc.
  minValue    Decimal  @default(0)
  maxValue    Decimal?
  minRole     String   @default("SUPERVISOR") // OPERATOR, SUPERVISOR, MANAGER, ADMIN
  requiresPin Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("approval_rules")
}

model ApprovalRequest {
  id              String    @id @default(uuid())
  companyId       String
  storeId         String?
  requesterId     String
  approverId      String?
  operation       String    // Código da operação solicitada
  value           Decimal?  // Valor ou percentual envolvido
  reason          String    // Motivo informado pelo solicitante
  terminal        String?   // Nome/ID do terminal/caixa/dispositivo
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  rejectionReason String?   // Motivo obrigatório em caso de negação
  authorizedAt    DateTime?
  expiresAt       DateTime?
  details         String?   // JSON com dados adicionais (ex: itens, venda, etc.)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  requester User    @relation("RequestedApprovals", fields: [requesterId], references: [id], onDelete: Cascade)
  approver  User?   @relation("AuthorizedApprovals", fields: [approverId], references: [id], onDelete: SetNull)

  @@map("approval_requests")
}

// ─────────────────────────────────────────────
// AUDITORIA IMUTÁVEL (AUDIT LOGS)
// ─────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String
  storeId      String?
  userId       String
  authorizerId String?
  operation    String   // Código da operação (ex: pdv.cancel_sale, user.update_permissions)
  action       String   // CREATE, UPDATE, DELETE, CANCEL, APPROVE, REJECT, OVERRIDE
  entity       String?  // Tabela/Entidade afetada (ex: Sale, User, Product)
  entityId     String?  // ID do registro afetado
  oldValue     String?  // JSON ou texto do estado anterior
  newValue     String?  // JSON ou texto do novo estado
  reason       String?  // Motivo ou justificativa
  ipAddress    String?
  terminal     String?  // Terminal/dispositivo de origem
  result       String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  createdAt    DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store      Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user       User    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)
  authorizer User?   @relation("AuthorizerAuditLogs", fields: [authorizerId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTISSETORIAL — MÓDULOS E PERFIL DE EMPRESA
// ─────────────────────────────────────────────────────────────────────────────

// Catálogo de módulos disponíveis no sistema
model SystemModule {
  id          String  @id @default(uuid())
  key         String  @unique // PDV, STOCK, PURCHASING, FINANCE, DISTRIBUTION, FACTORY, etc.
  name        String  // Nome amigável
  description String?
  icon        String? // Ícone (nome do lucide-react)
  category    String  // SALES, OPERATIONS, FINANCE, PRODUCTION, LOGISTICS
  planTier    String  @default("STARTER") // Plano mínimo necessário
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  @@map("system_modules")
}

// Módulos ativos por empresa (configuração individual)
model CompanyModule {
  id        String   @id @default(uuid())
  companyId String
  moduleKey String   // Referência ao SystemModule.key
  active    Boolean  @default(true)
  config    String?  // JSON com configurações específicas do módulo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleKey])
  @@map("company_modules")
}

// ─────────────────────────────────────────────────────────────────────────────
// ARMAZÉNS / CENTROS DE DISTRIBUIÇÃO
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id          String   @id @default(uuid())
  code        String   // CD01, FAB01, DEP01, LJ01
  name        String   // Centro de Distribuição SP, Depósito Principal
  type        String   @default("STORE") // FACTORY | DC | STORE | TRANSIT | DEPOT
  companyId   String
  storeId     String?  // Vinculado a uma loja se for estoque de loja
  active      Boolean  @default(true)
  // Endereço do armazém
  street      String?
  number      String?
  city        String?
  state       String?
  zipCode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks           WarehouseStock[]
  transfersFrom    StockTransfer[]  @relation("TransferFrom")
  transfersTo      StockTransfer[]  @relation("TransferTo")
  productionOrders ProductionOrder[]

  @@unique([companyId, code])
  @@map("warehouses")
}

// Estoque físico por armazém (físico vs reservado vs disponível)
model WarehouseStock {
  id            String   @id @default(uuid())
  warehouseId   String
  productId     String
  physicalQty   Float    @default(0) // Estoque físico real
  reservedQty   Float    @default(0) // Reservado por pedidos em aberto
  // Estoque disponível = physicalQty - reservedQty (calculado na aplicação)
  updatedAt     DateTime @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_stocks")
}

// Transferência de estoque entre armazéns / filiais
model StockTransfer {
  id              String   @id @default(uuid())
  number          String?  // ST-2024-0001
  fromWarehouseId String
  toWarehouseId   String
  status          String   @default("DRAFT") // DRAFT | SENT | IN_TRANSIT | RECEIVED | CANCELED
  invoiceId       String?  // NF-e de transferência
  userId          String
  companyId       String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse  Warehouse         @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse         @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items          StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id          String  @id @default(uuid())
  transferId  String
  productId   String
  quantity    Float
  unitCost    Decimal
  batchNumber String?

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// TABELAS DE PREÇO (MULTISSETORIAL)
// ─────────────────────────────────────────────────────────────────────────────

model PriceTable {
  id          String   @id @default(uuid())
  name        String   // Varejo, Atacado, Distribuidor, Cliente Especial, Promocional
  type        String   @default("FIXED") // FIXED | MARGIN | VOLUME
  description String?
  companyId   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PriceTableItem[]

  @@map("price_tables")
}

model PriceTableItem {
  id           String   @id @default(uuid())
  priceTableId String
  productId    String
  price        Decimal
  minQty       Float    @default(0)  // Quantidade mínima para esse preço
  maxQty       Float?               // Quantidade máxima (null = sem limite)
  maxDiscount  Decimal  @default(0) // Desconto máximo permitido (%)

  priceTable   PriceTable @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([priceTableId, productId, minQty])
  @@map("price_table_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTES B2B — ENDEREÇOS DE ENTREGA
// ─────────────────────────────────────────────────────────────────────────────

model DeliveryAddress {
  id           String   @id @default(uuid())
  customerId   String
  label        String   // "Matriz", "Filial Norte", "CD 01"
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("delivery_addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPEDIÇÃO — SEPARAÇÃO E CONFERÊNCIA
// ─────────────────────────────────────────────────────────────────────────────

model PickingList {
  id        String   @id @default(uuid())
  orderId   String   @unique
  status    String   @default("PENDING") // PENDING | IN_PROGRESS | PICKED | CHECKED | PACKED
  pickedBy  String?  // userId do separador
  checkedBy String?  // userId do conferente
  packedBy  String?  // userId do embalador
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PickingListItem[]

  @@map("picking_lists")
}

model PickingListItem {
  id            String  @id @default(uuid())
  pickingListId String
  productId     String
  quantity      Float
  pickedQty     Float   @default(0)
  batchNumber   String?
  status        String  @default("PENDING") // PENDING | PICKED | DIVERGENT

  pickingList   PickingList @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@map("picking_list_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOGÍSTICA — FROTA, MOTORISTAS E ROTAS
// ─────────────────────────────────────────────────────────────────────────────

model Vehicle {
  id        String   @id @default(uuid())
  plate     String
  model     String
  type      String   @default("TRUCK") // TRUCK | VAN | MOTORCYCLE | CARGO
  capacity  Decimal?
  companyId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routes    DeliveryRoute[]

  @@map("vehicles")
}

model Driver {
  id            String    @id @default(uuid())
  name          String
  cpf           String?
  cnh           String?
  cnhExpiration DateTime?
  phone         String?
  userId        String?   // Vinculado a um usuário do sistema
  companyId     String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routes    DeliveryRoute[]

  @@map("drivers")
}

model DeliveryRoute {
  id        String   @id @default(uuid())
  name      String   // "Rota SP Sul - Segunda"
  date      DateTime
  vehicleId String?
  driverId  String?
  status    String   @default("PENDING") // PENDING | IN_ROUTE | COMPLETED | PARTIAL
  companyId String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?    @relation(fields: [vehicleId], references: [id])
  driver    Driver?     @relation(fields: [driverId], references: [id])
  stops     RouteStop[]

  @@map("delivery_routes")
}

model RouteStop {
  id           String    @id @default(uuid())
  routeId      String
  orderId      String
  sequence     Int       // Ordem de entrega na rota
  status       String    @default("PENDING") // PENDING | DELIVERED | NOT_DELIVERED | RESCHEDULED
  notes        String?
  deliveredAt  DateTime?

  route        DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id])

  @@map("route_stops")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUÇÃO INDUSTRIAL — ORDEM DE PRODUÇÃO (OP)
// ─────────────────────────────────────────────────────────────────────────────

// ProductionLog existente mantido para retrocompatibilidade.
// ProductionOrder é o novo model para produção industrial avançada.

model ProductionOrder {
  id               String    @id @default(uuid())
  number           String    // OP-2024-0001 (gerado automaticamente)
  recipeId         String
  warehouseId      String?   // Onde será produzido
  status           String    @default("PLANNED")
  // PLANNED | RELEASED | IN_PROGRESS | PAUSED | FINISHED | CANCELED

  plannedQty       Float
  producedQty      Float     @default(0)
  rejectedQty      Float     @default(0)
  lossQty          Float     @default(0)

  plannedStart     DateTime?
  plannedEnd       DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?

  batchNumber      String?   // Lote gerado
  expirationDate   DateTime? // Validade calculada

  // Custo real calculado ao finalizar
  unitCostMaterial Decimal?  // Custo de matéria-prima por unidade
  unitCostLabor    Decimal?  // Custo de mão de obra por unidade
  unitCostOther    Decimal?  // Outros custos por unidade
  unitCostTotal    Decimal?  // Custo total unitário

  userId           String
  companyId        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipe           Recipe           @relation(fields: [recipeId], references: [id])
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumptions     ProductionConsumption[]
  qualityChecks    QualityCheck[]

  @@map("production_orders")
}

// Consumo real de insumos (registrado ao finalizar a OP)
model ProductionConsumption {
  id                String  @id @default(uuid())
  productionOrderId String
  productId         String  // Insumo consumido
  plannedQty        Float   // Quantidade planejada pela ficha técnica
  actualQty         Float   // Quantidade realmente consumida
  unitCost          Decimal // Custo unitário no momento
  batchNumber       String? // Lote do insumo utilizado

  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])

  @@map("production_consumptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTROLE DE QUALIDADE
// ─────────────────────────────────────────────────────────────────────────────

model QualityCheck {
  id                String   @id @default(uuid())
  productionOrderId String
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED | QUARANTINE
  checkedBy         String   // userId do responsável
  notes             String?
  checkedAt         DateTime @default(now())

  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  items             QualityCheckItem[]

  @@map("quality_checks")
}

model QualityCheckItem {
  id             String  @id @default(uuid())
  qualityCheckId String
  parameter      String  // pH, temperatura, aparência, peso, etc.
  expected       String  // Valor esperado
  actual         String  // Valor encontrado
  approved       Boolean // Aprovado?

  qualityCheck   QualityCheck @relation(fields: [qualityCheckId], references: [id], onDelete: Cascade)

  @@map("quality_check_items")
}
